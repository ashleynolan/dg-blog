---
layout: default.hbs
title: Blog
rss: false
---

<section class="content blog articles separator-top">
    {{#withSort collections.post 'data.posted' reverse=true}}
    <a href="{{ this.url }}" class="articles-item separator-bottom">
        <article>
            <time>{{moment this.data.posted format="DD/MM/YYYY"}}</time>
            <h2 class="articles-item-title">{{ this.data.title }}</h2>
            <p class="articles-item-description">{{ this.data.description }}</p>
        </article>
    </a>
    {{/withSort}}
</section>