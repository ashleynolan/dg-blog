---
layout: default.hbs
title: Blog
rss: false
---

<section class="c-content c-blog c-articles u-separator-top">
    {{#withSort collections.post 'data.posted' reverse=true}}
    <a href="{{ this.url }}" class="c-articles-item u-separator-bottom">
        <article>
            <time>{{moment this.data.posted format="DD/MM/YYYY"}}</time>
            <h2 class="c-articles-item-title">{{ this.data.title }}</h2>
            <p class="c-articles-item-description">{{ this.data.description }}</p>
        </article>
    </a>
    {{/withSort}}
</section>
