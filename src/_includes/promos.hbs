{{#if promo}}
{{#ifCond promo 'carbon'}}
<div class="c-promo c-promo--ad separator-both">
	<script async type="text/javascript" src="//cdn.carbonads.com/carbon.js?serve=CE7D5KQI&placement=ashleynolancouk"
		id="_carbonads_js"></script>
</div>
{{else}}
<div class="c-promo separator-both">
	{{#if promotitle}}
	<h2 class="c-promo-header text-bg">{{promotitle}}</h2>
	{{else}}
	<h2 class="c-promo-header text-bg">Recommended Resource</h2>
	{{/if}}
	<div class="c-promo-content">
	{{#ifCond promo 'sublime'}}
		<a href="https://SublimeTextBook.com/friend/NOLAN">
			<img class="c-promo-img" src="/assets/img/resources/wesbos.jpg" />
			<h3 class="c-promo-title">Sublime Text Power User</h2>
			<p class="c-promo-text">Level up your Sublime Text skills with this excellent book and video course by Wes Bos.</p>
		</a>
	{{/ifCond}}
	{{#ifCond promo 'react'}}
		<a href="https://ReactForBeginners.com/friend/NOLAN">
			<img class="c-promo-img c-promo-img--react" src="/assets/img/resources/react-for-beginners.jpg" />
			<h3 class="c-promo-title">React For Beginners</h2>
			<p class="c-promo-text">Upgrade your JavaScript skills – Learn React in just a couple of afternoons with this course by Wes Bos.</p>
		</a>
	{{/ifCond}}
	{{#ifCond promo 'advancedreact'}}
		<a href="https://advancedreact.com/friend/NOLAN">
			<img class="c-promo-img c-promo-img--advancedreact" src="/assets/img/resources/advanced-react.png" />
			<h3 class="c-promo-title">Advanced React &amp; GraphQL</h2>
			<p class="c-promo-text">Learn to Build Full Stack Applications with React and GraphQL in this course by Wes Bos.</p>
		</a>
	{{/ifCond}}
	{{#ifCond promo 'es6'}}
		<a href="https://ES6.io/friend/NOLAN">
			<img class="c-promo-img c-promo-img--es6" src="/assets/img/resources/es6.jpg" />
			<h3 class="c-promo-title">ES6 For Everyone</h2>
			<p class="c-promo-text">A premium training course to strengthen your core JavaScript skills and master all that ES6 has to offer, by Wes Bos.</p>
		</a>
	{{/ifCond}}
	{{#ifCond promo 'grid'}}
		<a href="https://CSSGrid.io/friend/NOLAN">
			<img class="c-promo-img" src="/assets/img/resources/css-grid.png" />
			<h3 class="c-promo-title">Learn CSS Grid</h2>
			<p class="c-promo-text">Learn all about CSS Grid with Wes Bos in this free video series!</p>
		</a>
	{{/ifCond}}
	{{#ifCond promo 'node'}}
		<a href="https://LearnNode.com/friend/NOLAN">
			<img class="c-promo-img" src="/assets/img/resources/node.png" />
			<h3 class="c-promo-title">Learn Node</h2>
			<p class="c-promo-text">The best way to learn Node.js, Express, MongoDB, and Friends</p>
		</a>
	{{/ifCond}}
	</div>
</div>
{{/ifCond}}
{{/if}}
