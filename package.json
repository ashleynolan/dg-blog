{
  "name": "dg-blog",
  "version": "0.1.0",
  "description": "Front-end development Blog and Portfolio for Ashley Watson-Nolan – Principal Engineer at Just Eat Takeaway",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && eleventy",
    "clean:dist": "rimraf dist",
    "dev": "yarn clean:dist && npx @11ty/eleventy --serve",
    "lint": "stylelint ./src/**/*.{css,scss}",
    "lint:fix": "yarn lint --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Ashley Watson-Nolan",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "@11ty/eleventy-plugin-handlebars": "1.0.0",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@justeattakeaway/stylelint-config-pie": "0.8.0",
    "autoprefixer": "10.4.20",
    "eleventy-plugin-rev": "2.0.0",
    "eleventy-sass": "3.0.0-beta.0",
    "esbuild": "0.24.2",
    "get-value": "3.0.1",
    "handlebars": "4.7.8",
    "handlebars-utils": "1.0.6",
    "helper-moment": "0.2.0",
    "include-media": "2.0.0",
    "ltx": "3.1.2",
    "normalize.css": "8.0.1",
    "postcss": "8.5.1",
    "postcss-csso": "6.0.1",
    "prismjs": "^1.29.0",
    "resolve": "1.22.10",
    "rimraf": "6.0.1",
    "stylelint": "16.9.0",
    "stylelint-config-standard-scss": "13.1.0"
  },
  "browserslist": [
    "defaults and supports es6-module"
  ],
  "stylelint": {
    "extends": "@justeattakeaway/stylelint-config-pie/base",
    "rules": {
      "no-descending-specificity": null
    }
  },
  "volta": {
    "node": "22.22.2"
  }
}
